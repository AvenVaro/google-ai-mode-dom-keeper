      "google-ai-mode-dom-kee[!p]*.code-workspace": true,
      "google-ai-mode-dom-keep[!e]*.code-workspace": true,
      "google-ai-mode-dom-keepe[!r]*.code-workspace": true,
      "google-ai-mode-dom-keeper[!.]*.code-workspace": true,
      "google-ai-mode-dom-keeper.*?*.code-workspace": true,
      "google-ai-mode-dom-keeper..code-workspace": true,
      "[!t]*/**/dist": true,
      "t[!e]*/**/dist": true,
      "te[!s]*/**/dist": true,
      "tes[!t]*/**/dist": true,
      "test[!s]*/**/dist": true,
      "tests/[!i]*/**/dist": true,
      "tests/i[!n]*/**/dist": true,
      "tests/in[!t]*/**/dist": true,
      "tests/int[!e]*/**/dist": true,
      "tests/inte[!g]*/**/dist": true,
      "tests/integ[!r]*/**/dist": true,
      "tests/integr[!a]*/**/dist": true,
      "tests/integra[!t]*/**/dist": true,
      "tests/integrat[!i]*/**/dist": true,
      "tests/integrati[!o]*/**/dist": true,
      "tests/integratio[!n]*/**/dist": true,
      "tests/integration/[!g]*/**/dist": true,
      "tests/integration/g[!o]*/**/dist": true,
      "tests/integration/go[!o]*/**/dist": true,
      "tests/integration/goo[!g]*/**/dist": true,
      "tests/integration/goog[!l]*/**/dist": true,
      "tests/integration/googl[!e]*/**/dist": true,
      "tests/integration/google[!-]*/**/dist": true,
      "tests/integration/google-[!a]*/**/dist": true,
      "tests/integration/google-a[!i]*/**/dist": true,
      "tests/integration/google-ai[!-]*/**/dist": true,
      "tests/integration/google-ai-[!m]*/**/dist": true,
      "tests/integration/google-ai-m[!o]*/**/dist": true,
      "tests/integration/google-ai-mo[!d]*/**/dist": true,
      "tests/integration/google-ai-mod[!e]*/**/dist": true,
      "tests/integration/google-ai-mode[!-]*/**/dist": true,
      "tests/integration/google-ai-mode-[!d]*/**/dist": true,
      "tests/integration/google-ai-mode-d[!o]*/**/dist": true,
      "tests/integration/google-ai-mode-do[!m]*/**/dist": true,
      "tests/integration/google-ai-mode-dom[!-]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-[!k]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-k[!e]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-ke[!e]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-kee[!p]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keep[!e]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keepe[!r]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keeper/**/dist/**/dist": true,
      "tests/integration/google-ai-mode-dom-keeper/[!d]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keeper/d[!i]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keeper/di[!s]*/**/dist": true,
      "tests/integration/google-ai-mode-dom-keeper/dis[!t]*/**/dist": true
    },
    "[javascript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[json]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[json-workspace]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[yaml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[yml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "files.associations": {
      "*.code-workspace": "jsonc"
    },
    "eslint.format.enable": true,
    "js/ts.format.enable": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always"
    },
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "json",
      "jsonc",
      "json-workspace",
      "yaml",
      "yml"
    ],
    "eslint.useFlatConfig": true,
    "eslint.nodePath": "node_modules",
    "eslint.workingDirectories": [
      {
        "mode": "auto"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "editorconfig.editorconfig"
    ]
  }
}
