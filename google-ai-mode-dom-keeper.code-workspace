{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules/": true,
      "*/**/*.code-workspace": true,
      "[!g]*.code-workspace": true,
      "g[!o]*.code-workspace": true,
