{
  "$schema": "./manifest-schema-v3.json",
  "manifest_version": 3,
  "name": "Google AI Mode DOM Keeper",
  "version": "1.0.0",
  "description": "Virtualizes chat messages in 'Google AI Mode' to eliminate typing delays, scrolling stutzes and input lags in massive conversations.",
  "icons": {
    "16": "img/icons/icon-google-ai-mode-dom-keeper-16x16.png",
    "32": "img/icons/icon-google-ai-mode-dom-keeper-32x32.png",
    "48": "img/icons/icon-google-ai-mode-dom-keeper-48x48.png",
    "128": "img/icons/icon-google-ai-mode-dom-keeper-128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*"
      ],
      "js": [
        "js/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
